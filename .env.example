# DB_NAME: nombre de la base en Aiven
DB_NAME=defaultdb
# DB_USER: usuario de Aiven
DB_USER=avnadmin
# DB_PASSWORD: la contraseña real va solo en .env y en Render
DB_PASSWORD=tu-password-de-aiven
# DB_HOST: host del servicio MySQL en Aiven
DB_HOST=tu-host.aivencloud.com
# DB_PORT: puerto que muestra Aiven
DB_PORT=12345
# SECRET_KEY: genera la tuya con get_random_secret_key (nunca la real aquí)
SECRET_KEY=cambia-esto-por-tu-clave
# DEBUG: True en local, False en Render
DEBUG=True
# ALLOWED_HOSTS: en Render agrega tu-proyecto.onrender.com
ALLOWED_HOSTS=127.0.0.1,localhost
# CSRF_TRUSTED_ORIGINS: en Render agrega https://tu-proyecto.onrender.com
CSRF_TRUSTED_ORIGINS=http://127.0.0.1:8000,http://localhost:8000